<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ArgosyDeltaBuilder</RootNamespace>
    <AssemblyName>ArgosyDeltaBuilder</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- shared with ArgosyUpdater -->
    <Compile Include="..\DeltaModel.cs" Link="Shared\DeltaModel.cs" />
    <Compile Include="..\ZeroDepJson.cs" Link="Shared\ZeroDepJson.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Octopus.Octodiff" Version="2.0.549" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ArgosyDeltaBuilder.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Install-ArgosyDeltaBuilderTask.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
